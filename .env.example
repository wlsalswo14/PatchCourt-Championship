# Never commit real values. Prefer an owner-readable secret file containing
# GEMINI_API_KEY or GEMMA_API_KEY and point PATCHCOURT_SECRET_FILE at it.
GEMINI_API_KEY=
PATCHCOURT_SECRET_FILE=
PATCHCOURT_GEMINI_MODEL=gemini-3.6-flash
PATCHCOURT_EXECUTION_MODE=offline-demo

# The API and owned synthetic fixture bind to loopback by default.
PATCHCOURT_API_HOST=127.0.0.1
PATCHCOURT_API_PORT=8787
PATCHCOURT_RUNTIME_ROOT=runtime
PATCHCOURT_WEB_ORIGINS=http://127.0.0.1:4175,http://localhost:4175

# Remote targets remain blocked unless both values below are set deliberately.
PATCHCOURT_ALLOW_OWNED_REMOTE=false
PATCHCOURT_OWNED_ORIGINS=

# Optional frontend override. Empty means same-origin API routes.
VITE_API_BASE_URL=
VITE_PATCHCOURT_TARGET_URL=http://127.0.0.1:4173
# Static public builds set this to true to skip API probes and disable the live CTA.
VITE_PUBLIC_REPLAY_ONLY=false

# When using a fresh alternate fixture port, change all three together, for example:
# PATCHCOURT_DEMO_PORT=4273
# PATCHCOURT_OWNED_ORIGINS=http://127.0.0.1:4273
# VITE_PATCHCOURT_TARGET_URL=http://127.0.0.1:4273
