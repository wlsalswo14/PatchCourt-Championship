{
  "name": "@patchcourt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "scripts": {
    "prebuild": "npm --workspace @patchcourt/core run build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test dist/test/api.test.js",
    "pretypecheck": "npm --workspace @patchcourt/core run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@patchcourt/core": "0.1.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
