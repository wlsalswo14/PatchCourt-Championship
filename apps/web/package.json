{
  "name": "@patchcourt/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:replay": "node scripts/sync-recorded-replay.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-public-e2e.mjs",
    "test:e2e:capture": "node scripts/run-public-e2e.mjs --capture-final",
    "test:e2e:live-states": "node scripts/run-live-e2e.mjs",
    "test:e2e:live-states:capture": "node scripts/run-live-e2e.mjs --capture-final",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^27.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
